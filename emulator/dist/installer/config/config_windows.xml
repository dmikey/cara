<?xml version="1.0" encoding="UTF-8"?>
<!-- Modified for Cara on 2026-11-12; see NOTICE for attribution. -->
<Installer>
    <Name>Cara</Name>
    <Version>1.0.0</Version>
    <Title>Cara Updater</Title>
    <Publisher>Cara Team</Publisher>
    <StartMenuDir>Cara</StartMenuDir>
    <!-- e.g. C:\home\<user>\AppData\Local\Cara -->
    <TargetDir>@HomeDir@/AppData/Local/Cara</TargetDir>
    <InstallerApplicationIcon>icon</InstallerApplicationIcon>
    <InstallerWindowIcon>icon.png</InstallerWindowIcon>
    <RemoteRepositories>
        <Repository>
            <Url>https://repo.citra-emu.org</Url>
            <Enabled>0</Enabled>
            <DisplayName>Legacy upstream Citra repository (disabled)</DisplayName>
        </Repository>
    </RemoteRepositories>
</Installer>
