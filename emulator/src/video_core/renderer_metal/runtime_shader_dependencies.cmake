function(cara_link_runtime_shader_libraries target)
    # Explicit local inputs allow the same pinned static compiler sources to be
    # built for macOS and iPhoneOS without any compiler executable on the device.
    set(CARA_METAL_GLSLANG_SOURCE "" CACHE PATH "Khronos glslang 16.6.0 source")
    set(CARA_METAL_SPIRV_CROSS_SOURCE "" CACHE PATH "Khronos SPIRV-Cross Vulkan SDK 1.4.350.0 source")
    if (NOT EXISTS "${CARA_METAL_GLSLANG_SOURCE}/glslang/Public/ShaderLang.h" OR
        NOT EXISTS "${CARA_METAL_SPIRV_CROSS_SOURCE}/spirv_msl.hpp")
        message(FATAL_ERROR "Runtime Metal shaders require both Khronos source directories")
    endif()
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_EXTERNAL OFF)
    set(ENABLE_OPT OFF)
    set(ENABLE_GLSLANG_BINARIES OFF)
    set(ENABLE_HLSL OFF)
    set(GLSLANG_TESTS OFF)
    set(GLSLANG_ENABLE_INSTALL OFF)
    set(SPIRV_CROSS_CLI OFF)
    set(SPIRV_CROSS_ENABLE_TESTS OFF)
    set(SPIRV_CROSS_ENABLE_HLSL OFF)
    set(SPIRV_CROSS_ENABLE_REFLECT OFF)
    set(SPIRV_CROSS_ENABLE_CPP OFF)
    set(SPIRV_CROSS_ENABLE_C_API OFF)
    set(SPIRV_CROSS_ENABLE_UTIL OFF)
    set(SPIRV_CROSS_SKIP_INSTALL ON)
    add_subdirectory("${CARA_METAL_GLSLANG_SOURCE}" "${CMAKE_BINARY_DIR}/cara-glslang" EXCLUDE_FROM_ALL)
    add_subdirectory("${CARA_METAL_SPIRV_CROSS_SOURCE}" "${CMAKE_BINARY_DIR}/cara-spirv-cross" EXCLUDE_FROM_ALL)
    target_link_libraries("${target}" PRIVATE glslang::glslang
        glslang::glslang-default-resource-limits spirv-cross-msl)
    target_compile_definitions("${target}" PRIVATE CARA_RUNTIME_METAL_SHADERS=1)
    if (CMAKE_SYSTEM_NAME STREQUAL "iOS")
        target_compile_definitions("${target}" PRIVATE CARA_RUNTIME_MSL_IOS=1)
    endif()
    target_sources("${target}" PRIVATE renderer_metal/pica_metal_runtime_shader.cpp)
endfunction()
