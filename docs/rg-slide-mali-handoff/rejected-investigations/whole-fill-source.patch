diff --git a/emulator/src/video_core/renderer_opengl/gl_whole_fill_validation.h b/emulator/src/video_core/renderer_opengl/gl_whole_fill_validation.h
new file mode 100644
index 00000000..498e97d3
--- /dev/null
+++ b/emulator/src/video_core/renderer_opengl/gl_whole_fill_validation.h
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cstdint>
+namespace OpenGL::WholeFillValidation {
+struct Proof {
+    std::uint64_t source_begin{}, source_end{}, destination_begin{}, destination_end{};
+    std::uint64_t selected_begin{}, selected_end{};
+    std::uint32_t width{}, height{}, stride{}, rect_left{}, rect_bottom{}, rect_right{}, rect_top{};
+    bool source_is_fill{}, source_full_valid{}, source_can_fill_full{}, destination_fully_invalid{};
+    bool destination_color_rgba8{}, registered{}, custom{}, mip_zero{}, scale_one{}, tiled{};
+};
+struct Plan { bool expand{}; std::uint64_t begin{}, end{}; };
+inline Plan MakePlan(const Proof& p) {
+    const Plan ordinary{false,p.selected_begin,p.selected_end};
+    if (!p.source_is_fill || !p.source_full_valid || !p.source_can_fill_full ||
+        !p.destination_fully_invalid || !p.destination_color_rgba8 || !p.registered ||
+        p.custom || !p.mip_zero || !p.scale_one || !p.width || !p.height || p.stride != p.width)
+        return ordinary;
+    if (p.source_begin != p.destination_begin || p.source_end != p.destination_end ||
+        p.destination_begin >= p.destination_end || p.selected_begin < p.destination_begin ||
+        p.selected_begin >= p.selected_end || p.selected_end > p.destination_end ||
+        p.selected_end-p.selected_begin == p.destination_end-p.destination_begin)
+        return ordinary;
+    const auto pixels=std::uint64_t(p.width)*p.height;
+    if (pixels > 0xffffffffULL/4 || pixels*4 != p.destination_end-p.destination_begin ||
+        (p.tiled && ((p.width|p.height)&7)) || p.rect_left || p.rect_bottom ||
+        p.rect_right != p.width || !p.rect_top || p.rect_top >= p.height)
+        return ordinary;
+    return {true,p.destination_begin,p.destination_end};
+}
+} // namespace OpenGL::WholeFillValidation
+
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+namespace OpenGL::WholeFillValidation {
+inline bool Enabled() {
+    static const bool enabled=[] {const char* v=std::getenv("CARA_GLES_WHOLE_FILL_VALIDATION");return v&&std::strcmp(v,"1")==0;}();
+    return enabled;
+}
+struct Counters {std::uint64_t candidates{},expansions{},selected_bytes{},materialized_bytes{};bool saturated{};};
+inline thread_local Counters counters;
+inline void Add(std::uint64_t& value,std::uint64_t amount) {
+    if(amount>std::numeric_limits<std::uint64_t>::max()-value){value=std::numeric_limits<std::uint64_t>::max();counters.saturated=true;}else value+=amount;
+}
+inline void Reset(){counters={};}
+} // namespace OpenGL::WholeFillValidation
