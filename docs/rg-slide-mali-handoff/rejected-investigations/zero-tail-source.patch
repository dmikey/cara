+template <typename Entry>
+inline bool EqualInput(const Entry& entry, const void* input, std::size_t size,
+                       std::size_t& full, bool filter_edges, std::size_t current_tail) {
+    if constexpr (requires { entry.input_zero_tail_begin; }) {
